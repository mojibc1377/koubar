generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum OrderType {
  SHOP
  CAFE
  MIXED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  PROCESSING
  DELIVERED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum RoasteryVariant {
  AFRICAN
  KENYA
  STREET
}

enum ItemSource {
  ROASTERY
  ACCESSORY
  CAFE
}

enum DiscountType {
  PERCENT
  FIXED
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  address   String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  transactions Transaction[]
  reviews      Review[]
  discountRedemptions DiscountRedemption[]
  jobApplications JobApplication[]

}

model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CafeCategory {
  id        String         @id
  name      String
  sortOrder Int            @default(0)
  items     CafeMenuItem[]
}

model CafeMenuItem {
  id              String       @id @default(cuid())
  slug            String       @unique
  categoryId      String
  category        CafeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  description     String
  longDescription String?
  image           String
  price           Int
  priceSecondary  Int?
  dualCoffeePricing Boolean    @default(false)
  linePrimaryLabel   String?
  lineSecondaryLabel String?
  badge           String?
  notes           Json         @default("[]")
  active          Boolean      @default(true)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model RoasteryProduct {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  description     String
  longDescription String?
  image           String
  price           Int
  badge           String?
  variant         RoasteryVariant @default(AFRICAN)
  inStock         Boolean         @default(true)
  active          Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Accessory {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  longDescription String?
  image           String
  price           Int
  badge           String?
  category        String
  notes           Json     @default("[]")
  inStock         Boolean  @default(true)
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BlogPost {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String
  image       String
  author      String
  category    String
  readMinutes Int
  status      BlogStatus @default(DRAFT)
  blocks      Json       @default("[]")
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            OrderType
  status          OrderStatus @default(PENDING)
  subtotal        Int?
  discountAmount  Int         @default(0)
  total           Int
  discountCodeId  String?
  discountCode    DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  discountRedemption DiscountRedemption?
  shippingName    String
  paymentAuthority  String?
   paymentRefId      String?
  shippingPhone   String
  shippingAddress String
  items           OrderItem[]
  transactions    Transaction[]
  review          Review?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([discountCodeId])
}

model DiscountCode {
  id        String       @id @default(cuid())
  code      String       @unique
  type      DiscountType
  value     Int
  active    Boolean      @default(true)
  expiresAt DateTime?
  maxUses   Int?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  orders      Order[]
  redemptions DiscountRedemption[]
}

model DiscountRedemption {
  id             String       @id @default(cuid())
  discountCodeId String
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String       @unique
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([discountCodeId, userId])
  @@index([userId])
}

model Staff {
  id        String   @id @default(cuid())
  name      String
  role      String
  avatar    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  reviews Review[]
}

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  staffStars Int
  foodStars  Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([staffId])
  @@index([userId])
}

model OrderItem {
  id        String     @id @default(cuid())
  orderId   String
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  source    ItemSource
  catalogId String
  title     String
  image     String?
  price     Int
  quantity  Int

  @@index([orderId])
}

model Transaction {
  id        String            @id @default(cuid())
  txNumber  String            @unique
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  method    String
  status    TransactionStatus @default(PAID)
  createdAt DateTime          @default(now())

  @@index([userId])
  @@index([orderId])
}


enum JobDepartment {
  CAFE      // barista, front of house, cashier...
  ROASTERY  // roasting, packaging, warehouse...
  GENERAL   // ops, admin, marketing, anything else
}

enum ApplicationStatus {
  SUBMITTED
  IN_REVIEW
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model JobApplication {
  id                 String             @id @default(cuid())
  applicationNumber  String             @unique
  fullName           String
  phone              String
  email              String?

  age                Int?
  marriageStatus     MarriageStatus?
  militaryStatus     MilitaryStatus?
  address            String?

  department         JobDepartment
  positionTitle      String
  message            String?
  resumeUrl          String
  resumeFileName     String
  status             ApplicationStatus  @default(SUBMITTED)

  userId             String?
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status])
  @@index([department])
  @@index([userId])
}

enum MarriageStatus {
  SINGLE
  MARRIED

}

enum MilitaryStatus {
  NOT_APPLICABLE
  IN_PROGRESS
  COMPLETED
}